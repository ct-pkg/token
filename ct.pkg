# token - rough token-budget estimation for agent context management.
#
# Deliberately not a tokenizer: no BPE, no vocabulary, no model tables.
# Integer-only arithmetic over UTF-8 bytes; no heap allocation, no I/O,
# no third-party dependencies. The estimate is deliberately conservative
# for budgeting: under-estimation is bounded tighter than over-estimation.
#
# `requires = ct >= 0.44.1`: the lower bound tracks the current CT release.
# The language features this package actually relies on arrived in Phase 36
# (built-in `Str` handle, v0.36.0) and Phase 34 (static inherent methods,
# v0.34.0).
name = token
publisher = ct
ns-root = .
version = 0.1.1
licence = MIT
requires = ct >= 0.44.1
